# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (public client configuration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Supabase (server-only - never expose this key to client code or commit it)
# Optional for admin maintenance scripts such as scripts/seed-grants.mjs
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google sign-in is configured in Supabase Authentication -> Providers -> Google.
# No Google client ID is needed in the browser; Supabase owns the OAuth redirect.
# Set this to the deployed app origin in production (no trailing path).
NEXT_PUBLIC_SITE_URL=https://www.grantclient.com

# Search Console HTML-tag verification token (content value only, no markup)
GOOGLE_SITE_VERIFICATION=

# API (optional)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Grants.gov Simpler API (server-only)
SIMPLER_GRANTS_API_KEY=your_simpler_grants_api_key

# NVIDIA NIM (server-only)
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=
NVIDIA_NIM_TIMEOUT_MS=25000
NVIDIA_NIM_MAX_RETRIES=2
AI_PROVIDER=nvidia
